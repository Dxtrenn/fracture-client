{
  "name": "fracture-client",
  "productName": "Fracture Client",
  "version": "1.0.4",
  "description": "A lightweight Minecraft PvP launcher",
  "main": "src/main.js",
  "author": "DxTrenn",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis",
    "dist:mac": "electron-builder --mac dmg --x64 --arm64"
  },
  "dependencies": {
    "extract-zip": "2.0.1",
    "minecraft-launcher-core": "3.18.2",
    "msmc": "5.0.5",
    "qrcode": "1.5.4",
    "yauzl": "2.10.0"
  },
  "devDependencies": {
    "electron": "github:castlabs/electron-releases#v38.8.6+wvcus",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "com.fracture.client",
    "productName": "Fracture Client",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png",
      "artifactName": "Fracture-Client-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Fracture Client"
    },
    "electronVersion": "38.8.6+wvcus",
    "electronDownload": {
      "mirror": "https://github.com/castlabs/electron-releases/releases/download/v"
    },
    "extraResources": [
      {
        "to": "fracture-mod.jar",
        "from": "resources/fracture-mod.jar"
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.games",
      "identity": null,
      "artifactName": "Fracture-Client-${version}-mac-${arch}.${ext}"
    },
    "dmg": {
      "title": "Fracture Client"
    },
    "afterPack": "build/adhoc-sign.js"
  }
}
